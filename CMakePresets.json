{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "esp32s3",
      "displayName": "ESP32-S3 firmware (ESP-IDF)",
      "generator": "Ninja",
      "binaryDir": "build",
      "cacheVariables": {
        "IDF_TARGET": "esp32s3",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "esp32s3",
      "configurePreset": "esp32s3"
    }
  ]
}
